# HRM API connection for the module-connect React frontend.
# Copy to `.env.local` (git-ignored) and edit for your environment.

# Base URL of the ASP.NET Core HRM API, WITHOUT a trailing slash.
# Local dev: the .NET API runs on port 5199.
# Production (behind the nginx reverse proxy): use the proxy path, e.g. /api
VITE_HRM_API_BASE=http://localhost:5199/api

# Set to "true" to call the real ASP.NET backend instead of the demo mock data.
# Leave as "false" for demo/storytelling mode where nothing is persisted.
VITE_USE_REAL_API=false

# Default tenant scope for unauthenticated (auth-disabled) development sessions.
# ZML (Mighty Finance Solutions Industrial Services Zambia Ltd) legal entity.
VITE_HRM_TENANT_ID=019ffa8b-0fb0-71e6-849a-f76e5a28e0b5
